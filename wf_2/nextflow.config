cleanup = true

process.executor = 'slurm'
conda.enabled = false
conda.useMicromamba = false

process {
    executor = 'slurm'
    cpus = 128
    time = '24h'
    beforeScript = """
        export PATH=/usr/WS1/mlbiomon/software/mamba/bin:\$PATH
    """
}

executor {
    name = 'slurm'
    queueSize = 20
    submitRateLimit = '20/1min'
}

params {
    metadata = "${projectDir}/metadata.tsv"
    m = null

    threads = 128

    megahit_env = '/usr/WS1/mlbiomon/software/mamba/envs/megahit'
    seqkit_env = '/usr/WS1/mlbiomon/software/mamba/envs/preprocessing'
    checkv_env = '/usr/WS1/mlbiomon/software/mamba/envs/checkv'
    genomad_env = '/usr/WS1/mlbiomon/software/mamba/envs/genomad'

    checkv_db = '/p/vast1/mlbiomon/analysis/securebio/viral_genomes_analysis/checkv_db/checkv-db-v1.5'
    genomad_db = '/p/vast1/mlbiomon/ref_data/genomad_db_1.9/genomad_db'

    read_root = '/p/biolustre1/mlbiomon/analysis/securebio/fastq/modular_testing'
    read_subdir = 'processed'
    output_subdir = 'assembly'

    final_reads_suffix = '_no_rrna_final_reads.fastq.gz'
}

params.pipeline_info_dir = "${launchDir}/pipeline_info"
params.trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline {
    enabled = true
    file = "${params.pipeline_info_dir}/execution_timeline_${params.trace_timestamp}.html"
}

report {
    enabled = true
    file = "${params.pipeline_info_dir}/execution_report_${params.trace_timestamp}.html"
}

trace {
    enabled = true
    file = "${params.pipeline_info_dir}/execution_trace_${params.trace_timestamp}.txt"
}

dag {
    enabled = true
    file = "${params.pipeline_info_dir}/pipeline_dag_${params.trace_timestamp}.html"
}

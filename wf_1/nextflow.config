cleanup = true

process {
    executor = 'slurm'
    beforeScript = { "export PATH=${params.conda_env}/bin:\$PATH" }
    cpus = 128
    time = '24h'
}

executor {
    name = 'slurm'
    queueSize = 20
    submitRateLimit = '20/1min'
}

params {
    /*
     * Metadata can be supplied with either:
     *   --metadata metadat.csv
     *   --m metadat.csv
     */
    metadata = "${baseDir}/metadat.csv"
    m = null

    /*
     * Default input mode is interleaved.
     * Use --paired_end true for R1/R2 paired-end input.
     */
    paired_end = false

    conda_env = '/usr/WS1/mlbiomon/software/mamba/envs/preprocessing'

    /*
     * DEACON host depletion.
     * The DEACON process runs twice:
     *   - with -d to emit non-human/final reads
     *   - without -d to emit human/matching reads
     */
    deacon_threads = 64
    deacon_db = '/p/vast1/mlbiomon/ref_data/deacon_panhuman-1/panhuman-1.k31w15.idx'

    /*
     * Keep Human Scrubber params for modules/deacon/run_humscrub.nf.
     * That module is not currently included by main.nf, but leave this here
     * while run_humscrub.nf still exists.
     */
    scrub_threads = 64
    sra_hum_scrub_db = '/p/vast1/mlbiomon/ref_data/sra-human-scrubber/human_filter.db.20240718v2'

    read_root = '/p/biolustre1/mlbiomon/analysis/securebio/fastq/modular_testing'
    read_subdir = 'concat'
    output_subdir = 'test_processed'

    paired_r1_suffix = '_R1.clumped.fastq.gz'
    paired_r2_suffix = '_R2.clumped.fastq.gz'
    interleaved_suffix = '.clumped.fastq.gz'

    bbduk_db = '/p/vast1/mlbiomon/ref_data/bbtools/riboKmers20fused.fa'
}

/*
 * Derive the run-level pipeline_info location from the metadata file.
 *
 * Required metadata column:
 *   Experiment
 *
 * The metadata file must contain exactly one unique Experiment per run.
 */
def metadata_path = params.m ?: params.metadata
def metadata_file = new File(metadata_path.toString())

if (!metadata_file.exists()) {
    throw new IllegalArgumentException("Metadata file does not exist: ${metadata_path}")
}

def non_empty_lines = metadata_file.readLines().findAll { it?.trim() }

if (non_empty_lines.size() < 2) {
    throw new IllegalArgumentException("Metadata file must contain a header and at least one data row: ${metadata_path}")
}

def header = non_empty_lines[0].split('\t', -1)
def experiment_idx = header.findIndexOf { it == 'Experiment' }

if (experiment_idx < 0) {
    throw new IllegalArgumentException("Metadata file is missing required column: Experiment")
}

def experiments = non_empty_lines
    .drop(1)
    .collect { line ->
        def fields = line.split('\t', -1)
        fields[experiment_idx]?.trim()
    }
    .findAll { it }

def unique_experiments = experiments.unique()

if (unique_experiments.size() != 1) {
    throw new IllegalArgumentException("Metadata file must contain exactly one Experiment per run. Found: ${unique_experiments}")
}

def run_batch_name = unique_experiments[0]
def pipeline_info_dir = "${params.read_root}/${run_batch_name}/${params.output_subdir}/pipeline_info"
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline {
    enabled = true
    file = "${pipeline_info_dir}/execution_timeline_${trace_timestamp}.html"
}

report {
    enabled = true
    file = "${pipeline_info_dir}/execution_report_${trace_timestamp}.html"
}

trace {
    enabled = true
    file = "${pipeline_info_dir}/execution_trace_${trace_timestamp}.txt"
}

dag {
    enabled = true
    file = "${pipeline_info_dir}/pipeline_dag_${trace_timestamp}.html"
}
